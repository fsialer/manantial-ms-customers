{
  "id": null,
  "title": "Dashboard Manantial",
  "tags": [],
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "type": "row",
      "title": "🚀 Estado general de los servicios",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Estado de Servicios",
      "targets": [
        {
          "expr": "up{type=\"backend\"}",
          "legendFormat": "🔧 Backend  {{job}}",
          "refId": "A"
        },
        {
          "expr": "up{type=\"monitoring\"}",
          "legendFormat": "📊 Metricas {{job}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "❌ CAÍDO"
                },
                "1": {
                  "text": "✅ OK"
                }
              },
              "type": "value"
            }
          ]
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background"
      },
      "gridPos": {
        "h": 12,
        "w": 8,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "row",
      "title": "🔧 Backend",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tasa de Request (Req/Sec)",
      "gridPos": {
        "h": 12,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{job=\"customer-service\"}[1m])",
          "legendFormat": "{{job}} - {{uri}} {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }

    },
    {
      "type": "row",
      "title": "📊 Infraestructura",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "collapsed": false
    },

    {
      "id": 3,
      "type": "timeseries",
      "title": "CPU Actual (%)",
      "gridPos": {
        "h": 12,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "process_cpu_usage{type=\"backend\"} * 100",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } }

    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Consumo De Memoria Heap",
      "gridPos": {
        "h": 12,
        "w": 8,
        "x": 8,
        "y": 24
      },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\"}",
          "legendFormat": "{{job}} ({{id}})",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Memoria Heap Usada (%)",
      "gridPos": {
        "h": 12,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "targets": [
        {
          "expr": "100 * (jvm_memory_used_bytes{area=\"heap\"} / ignoring(instance) jvm_memory_max_bytes{area=\"heap\"} > 0)",
          "legendFormat": "{{job}} ({{id}})",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "type": "row",
      "title": "📄 Logging",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "collapsed": false
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Logs de Customer Service [INFO]",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "expr": "{job=\"customer-service\"} |= \"INFO\"",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 7,
